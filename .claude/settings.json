{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/scripts/PreBashLinuxCommands.js"
          },
          {
            "type": "command",
            "command": "node .claude/scripts/PreBashCdOutsideWorkspace.js"
          },
          {
            "type": "command",
            "command": "node .claude/scripts/PreBashKillPort.js"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/scripts/Stop.js"
          }
        ]
      }
    ]
  }
}
